<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: the same header as medium, plus quick-start chips when idle or a Cancel row when a
     timer is running. Also the previewLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_glyph_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/overlay_on_scrim_secondary"
                android:textSize="11sp"
                tools:ignore="SmallSp" />

            <Chronometer
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_static"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/overlay_on_scrim"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Idle: quick-start chips, text pushed as "5m" / "10m" / "15m". -->
    <LinearLayout
        android:id="@+id/widget_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_5"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:textColor="@color/overlay_on_chip"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_chip_10"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:textColor="@color/overlay_on_chip"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_chip_15"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:textColor="@color/overlay_on_chip"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Running: cancel. Mirrors btn_cancel in timer_picker.xml. -->
    <TextView
        android:id="@+id/widget_cancel"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/chip_bg"
        android:gravity="center"
        android:textColor="@color/overlay_danger"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
