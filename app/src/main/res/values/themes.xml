<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent so MainActivity (AppCompatActivity, for per-app language) is happy.
         The actual UI is Compose (PauseTheme); this is just the window/launch theme. -->
    <style name="Theme.Pause" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Theme used when inflating the overlay picker, so the platform NumberPicker /
         TimePicker spinners match the surface. Light variant here; values-night/themes.xml
         overrides it with the dark parent for dark mode. -->
    <style name="Theme.Pause.Overlay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#FF7C5CFF</item>
        <item name="android:textColorPrimary">@color/overlay_on_scrim</item>
        <item name="android:textColorSecondary">@color/overlay_on_scrim_secondary</item>
    </style>

    <!-- PauseLaunchActivity's theme: fully transparent and undecorated, since the activity
         never actually draws anything. It starts a service or another activity, then
         finishes on the same frame. -->
    <style name="Theme.Pause.Launch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
